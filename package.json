{
  "name": "econet-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evaluate": "tsx scripts/evaluate-rag.ts",
    "audit:dashboard": "tsx scripts/audit-dashboard.ts",
    "audit:benchmark": "tsx scripts/audit-benchmark.ts",
    "audit:preflight": "tsx scripts/audit-benchmark.ts --preflight",
    "audit:benchmark:pair": "tsx scripts/audit-benchmark.ts --pair",
    "audit:compare": "tsx scripts/audit-compare.ts",
    "audit:report": "tsx scripts/audit-report.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.3.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.10.38",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/node-fetch": "^2.6.12",
    "jszip": "^3.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
