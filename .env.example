TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789

INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
RAG_EMBEDDING_DIMENSION=768

LLM_TIMEOUT_MS=60000
EMBEDDING_TIMEOUT_MS=60000
AGENT_TIMEOUT_MS=300000
DOCUMENT_TIMEOUT_MS=300000
AGENT_MAX_STEPS=5
EXEC_TIMEOUT_MS=30000

CHAT_HISTORY_MESSAGES=20
CHAT_DB_PATH=./data/chat-history.sqlite
RAG_DB_PATH=./data/rag.sqlite
DOCUMENT_TEMP_DIR=./data/tmp-documents
MAX_DOCUMENT_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=1000000
RAG_CHUNK_SIZE_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=300
EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=5
RAG_MAX_DISTANCE=1.0
RAG_MAX_CONTEXT_CHARS=8000

SKILLS_DIR=./skills
AGENT_WORKSPACE_DIR=./agent-workspace

TOKEN_AUDIT_ENABLED=true
TOKEN_AUDIT_DB_PATH=./data/token-audit.sqlite
TOKEN_AUDIT_AGENT_ID=econet-bot
TOKEN_AUDIT_PROFILE=optimized
CHAT_HISTORY_TOKEN_BUDGET=1600
EXEC_MODEL_OUTPUT_MAX_CHARS=3000
RAG_MODEL_CONTEXT_MAX_CHARS=4500
# Benchmark-only context and timeouts, identical for both profiles.
TOKEN_AUDIT_BENCHMARK_NUM_CTX=16384
TOKEN_AUDIT_BENCHMARK_LLM_TIMEOUT_MS=180000
# Optional per-conversation-turn case budget; cannot be shorter than
# AGENT_MAX_STEPS * (benchmark LLM timeout + 1000) + 10000.
# TOKEN_AUDIT_BENCHMARK_CASE_TIMEOUT_MS=915000
TOKEN_AUDIT_INPUT_USD_PER_1M=0
TOKEN_AUDIT_CACHED_INPUT_USD_PER_1M=0
TOKEN_AUDIT_OUTPUT_USD_PER_1M=0
TOKEN_AUDIT_REASONING_USD_PER_1M=0

# Opt-in behavioral model benchmark fallback. The CLI can instead use
# `--model_1 <name> --model_2 <name>`. Choose models shown by `ollama list`;
# the benchmark never pulls models or edits OLLAMA_MODEL.
# EVAL_MODELS=model-a,model-b
EVAL_REPETITIONS=1
EVAL_TEMPERATURE=0
EVAL_OUTPUT_DIR=./artifacts/model-evaluation
EVAL_INCLUDE_OUTPUT_PREVIEWS=false
